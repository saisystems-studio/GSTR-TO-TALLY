# --- Nexus environment (choose ONE; there is no automatic fallback between them) ---
# Switching only needs this value + a backend restart; no code change or Connector rebuild.
# LOCAL DEV:   NEXUS_BASE_URL=http://127.0.0.1:8001/   (local Nexus must be running)
# PRODUCTION:  NEXUS_BASE_URL=https://saitallyexpert.in/nexus/
# NEXUS_PRODUCT_KEY / NEXUS_EVENT_SIGNING_SECRET must be the key/secret issued by the SAME Nexus.
NEXUS_ENABLED=True
NEXUS_BASE_URL=http://127.0.0.1:8001/
NEXUS_PRODUCT_ID=gstr2tally
NEXUS_PRODUCT_KEY=
NEXUS_TIMEOUT=15

# Nexus event signing (set the same value as Nexus TALLY_EVENT_SIGNING_SECRET; never commit the real value)
NEXUS_EVENT_SIGNING_SECRET=
NEXUS_EVENTS_PATH=events/device-transfer/
